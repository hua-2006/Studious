# 统一换行符，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.gguf binary
*.zip binary
*.exe binary
*.dll binary
*.a binary
*.lib binary

# GitHub 语言统计：第三方代码不计入
backend/third_party/** linguist-vendored
installer/ChineseSimplified.isl linguist-vendored

# 头文件一律按 C++ 计：.h 会被 linguist 按内容猜成 C（AppSettings.h 就中招过）
*.h linguist-language=C++
*.hpp linguist-language=C++